# Copy this file to .env and fill in your key:  cp .env.example .env

# Required. Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your-key-here

# Groq model used for narrative generation, query decomposition and synthesis.
# If this starts returning 404/400, the model was deprecated — check
# https://console.groq.com/docs/deprecations
LLM_MODEL=openai/gpt-oss-20b

# Local sentence-transformers model. CPU-only, downloads on first use.
# NOTE: chunk size in src/extractors/text_extractor.py is derived from this
# model's max_seq_length — swapping the model re-derives it automatically.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Paths (relative to the project root)
CHROMA_DIR=chroma_store
GENERATED_DIR=data/generated
