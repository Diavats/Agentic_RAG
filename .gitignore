# --- Secrets ---
.env

# --- Python ---
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Generated artifacts: COMMITTED, deliberately ---
# data/generated/*_units.json holds the extracted KnowledgeUnits, including
# LLM-written narratives that cost one Groq call per row to produce. Losing
# them means re-spending rate limit to recreate identical content, so they are
# tracked. They are also what the index is rebuilt from, with zero API calls.
data/generated/*_stories.json

# --- Built indexes: COMMITTED, deliberately ---
# Render's free tier has an ephemeral filesystem and sleeps after ~15 min, so
# the deployed API serves a pre-built, read-only index baked into the image.
# Ingestion stays an offline admin operation. ~936K, rebuildable from
# data/generated/ with `python -m src.main index --domain <d>` (no API calls).

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
