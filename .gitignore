# --- Secrets ---
.env

# --- Python ---
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Generated artifacts: COMMITTED, deliberately ---
# data/generated/*_units.json holds the extracted KnowledgeUnits, including
# LLM-written narratives that cost one Groq call per row to produce. Losing
# them means re-spending rate limit to recreate identical content, so they are
# tracked. They are also what the index is rebuilt from, with zero API calls.
data/generated/*_stories.json

# --- Built indexes: NOT committed ---
# Chroma writes to its SQLite and HNSW segments on READ, so a single query
# dirties three binary files. Committing the index meant every query produced a
# spurious diff.
#
# data/generated/*_units.json IS committed instead: it is text, it diffs
# cleanly, and it holds the expensive part (one Groq call per row). The index
# rebuilds from it with ZERO API calls in a couple of seconds, so the deployed
# API builds it at startup rather than shipping it in the image.
chroma_store/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/

# --- Working trace log ---
# Raw append-only log of every query run locally. The CURATED subset lives in
# docs/TRACES.md and IS committed - that is the artifact worth reading.
logs/

# --- Test artifacts ---
.pytest_cache/
pytest_run.log

# --- LLM response cache (eval harness only) ---
# Regenerates itself; can be large. Delete it to force fresh API calls.
.llm_cache/

# Eval run log (regenerated by src/eval/run_eval.py)
eval_run.log
